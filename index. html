<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>CAR VIBES</title>

<style>
*{
  box-sizing:border-box;
  margin:0;
  padding:0;
}

body{
  font-family:Arial,sans-serif;
  background:#050505;
  color:white;
  min-height:100vh;
}

.hero{
  min-height:100vh;
  padding:30px 20px;
  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:center;
  text-align:center;
  background:
    radial-gradient(circle at top,#3b2700 0%,#100d05 35%,#050505 70%);
}

.logo{
  font-size:22px;
  letter-spacing:5px;
  color:#d6a83b;
  font-weight:bold;
  margin-bottom:20px;
}

.car{
  font-size:85px;
  filter:drop-shadow(0 0 25px #d6a83b);
  margin-bottom:15px;
}

h1{
  font-size:52px;
  letter-spacing:8px;
  margin-bottom:12px;
}

.subtitle{
  color:#aaa;
  font-size:16px;
  margin-bottom:35px;
}

.player{
  width:min(520px,95%);
  padding:25px;
  border:1px solid #5c4618;
  border-radius:25px;
  background:rgba(20,20,20,.9);
  box-shadow:0 0 40px rgba(214,168,59,.15);
}

.song-title{
  color:#d6a83b;
  font-size:20px;
  margin-bottom:8px;
}

.status{
  color:#888;
  font-size:13px;
  margin-bottom:20px;
}

.controls{
  display:flex;
  justify-content:center;
  gap:12px;
}

button{
  border:none;
  border-radius:50%;
  width:55px;
  height:55px;
  cursor:pointer;
  background:#d6a83b;
  color:#080808;
  font-size:21px;
  font-weight:bold;
}

button:hover{
  transform:scale(1.08);
}

.play{
  width:70px;
  height:70px;
  font-size:28px;
}

.categories{
  display:flex;
  flex-wrap:wrap;
  justify-content:center;
  gap:10px;
  margin-top:30px;
}

.category{
  padding:10px 17px;
  border:1px solid #4d3a15;
  border-radius:30px;
  color:#ccc;
  background:#101010;
}

.footer{
  margin-top:35px;
  color:#555;
  font-size:12px;
}
</style>
</head>

<body>

<section class="hero">

  <div class="logo">CAR VIBES</div>

  <div class="car">🚗</div>

  <h1>DRIVE THE VIBE</h1>

  <p class="subtitle">
    Original beats for your ultimate drive.
  </p>

  <div class="player">

    <div class="song-title" id="songTitle">
      Night Drive
    </div>

    <div class="status" id="status">
      Ready to drive 🎵
    </div>

    <div class="controls">
      <button onclick="previousBeat()">⏮</button>
      <button class="play" onclick="toggleMusic()" id="playBtn">▶</button>
      <button onclick="nextBeat()">⏭</button>
    </div>

  </div>

  <div class="categories">
    <div class="category">🏎️ Racing</div>
    <div class="category">🌃 Night Drive</div>
    <div class="category">🛣️ Highway</div>
    <div class="category">🔥 Sport</div>
    <div class="category">🌆 City</div>
  </div>

  <div class="footer">
    CAR VIBES • Original Browser Beats
  </div>

</section>

<script>

let audioContext;
let playing=false;
let timer;

const beats=[
  "Night Drive",
  "Midnight Highway",
  "Turbo Run",
  "City Lights"
];

let current=0;

function startAudio(){

  if(!audioContext){
    audioContext=new (window.AudioContext ||
      window.webkitAudioContext)();
  }

  if(audioContext.state==="suspended"){
    audioContext.resume();
  }
}

function playBeat(){

  startAudio();

  const now=audioContext.currentTime;

  const osc=audioContext.createOscillator();
  const gain=audioContext.createGain();

  osc.type="sawtooth";

  const notes=[110,146.83,164.81,196];

  osc.frequency.setValueAtTime(
    notes[Math.floor(Math.random()*notes.length)],
    now
  );

  gain.gain.setValueAtTime(0.0001,now);
  gain.gain.exponentialRampToValueAtTime(.18,now+.03);
  gain.gain.exponentialRampToValueAtTime(.0001,now+.35);

  osc.connect(gain);
  gain.connect(audioContext.destination);

  osc.start(now);
  osc.stop(now+.4);
}

function toggleMusic(){

  if(!playing){

    startAudio();

    playing=true;

    document.getElementById("playBtn").innerHTML="⏸";
    document.getElementById("status").innerHTML="Now playing • Driving Beat";

    timer=setInterval(playBeat,420);

  }else{

    playing=false;

    clearInterval(timer);

    document.getElementById("playBtn").innerHTML="▶";
    document.getElementById("status").innerHTML="Paused";
  }
}

function nextBeat(){

  current=(current+1)%beats.length;

  document.getElementById("songTitle").innerHTML=
    beats[current];

  if(playing){
    clearInterval(timer);
    timer=setInterval(playBeat,350);
  }
}

function previousBeat(){

  current=(current-1+beats.length)%beats.length;

  document.getElementById("songTitle").innerHTML=
    beats[current];
}

</script>

</body>
</html>
